# siballe gunicorn systemd unit — committed source of truth, symlinked into
# /etc/systemd/system/gunicorn-siballe.service on the VPS. See DEPLOY.md.
#
# --workers below uses the standard "2 * cores + 1" formula. It is hardcoded
# here (not computed at runtime) so systemd doesn't need a shell wrapper;
# recompute and edit it if you ever resize the VPS. Run `nproc` on the VPS to
# check the core count.

[Unit]
Description=Gunicorn for siballe backend
After=network.target postgresql.service

[Service]
Type=simple
User=siballe
Group=www-data
UMask=0007
RuntimeDirectory=siballe
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/siballe/app/backend
ExecStart=/home/siballe/.local/bin/uv run gunicorn config.wsgi:application \
    --bind unix:/run/siballe/gunicorn.sock \
    --workers 3 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
