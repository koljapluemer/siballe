DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to a local sqlite file if unset/commented out. For deploy, e.g.:
# DATABASE_URL=postgres://siballe:CHANGE_ME@localhost:5432/siballe
# Origins allowed to call this API cross-origin (only needed when the frontend and
# backend are NOT same-origin, e.g. local dev where Vite runs on :5173; in
# production the frontend is served from the same origin as the API, so leave
# this empty there).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required once behind nginx with DJANGO_DEBUG=False, so /admin/ POSTs pass CSRF.
# e.g. http://YOUR_VPS_IP (add https://your-domain.tld once a domain exists). See
# DEPLOY.md.
DJANGO_CSRF_TRUSTED_ORIGINS=
