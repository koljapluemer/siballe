DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to a local sqlite file if unset/commented out. For deploy, e.g.:
# DATABASE_URL=postgres://siballe:siballe@localhost:5432/siballe
# Origins allowed to call this API cross-origin (e.g. the Flutter web dev server).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
